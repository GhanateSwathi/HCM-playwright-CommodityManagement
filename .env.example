# Copy this file to .env in the project root and fill in the values.
# .env is gitignored and must never be committed.

# Login page of the workbench-ui under test. Each tenant/environment has its
# own host:
#   Bauchi prod -> https://bauchi-hcm.digit.org/workbench-ui/employee/user/login
#   Bauchi UAT  -> https://bauchi-hcm-uat.digit.org/workbench-ui/employee/user/login
HCM_WEB_URL=https://bauchi-hcm.digit.org/workbench-ui/employee/user/login

# Employee credentials for the target environment.
HCM_WEB_USER_ID=
HCM_WEB_PASSWORD=

# The Country/State/City selection on the login form. Data-dependent: it must be
# an option actually offered in the environment the URL points at.
HCM_WEB_CITY=Bauchi

# Campaign the Commodity Management tests operate on.
HCM_CAMPAIGN_NAME=BAUCHI_SMC_Campaign_2026

# Bulk Stock Upload: the destination facility to ship to, exactly as the
# checkbox label renders it.
HCM_TO_FACILITY=State CMS (F-2026-06-13-030843)

# Quantities written into the SPAQ 1 and SPAQ 2 columns of the stock template.
HCM_SPAQ1=200
HCM_SPAQ2=200

# Safety switch. The Submit button writes real stock records to whatever
# environment HCM_WEB_URL points at. The upload test refuses to submit unless
# this is exactly "true", so a stray run cannot create data by accident.
HCM_ALLOW_SUBMIT=false
